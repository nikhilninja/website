# ─────────────────────────────────────────────────────────────
# Sarani Website & CCTV - Docker Environment Configuration
# ─────────────────────────────────────────────────────────────

# Admin Panel & Live Stream Password
ADMIN_PASSWORD=sarani2025
VITE_LIVE_PASSWORD=sarani2025

# Host / IP for WebRTC ICE Candidates (Set to Ubuntu server's LAN IP e.g. 192.168.1.50)
WEBRTC_ADDITIONAL_HOSTS=192.168.31.184

# Automatically start Cloudflare Tunnel when running 'docker compose up'
# Set to 'tunnel' if you want Cloudflare to start, or leave empty for local-only mode:
COMPOSE_PROFILES=tunnel

# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard)
# Paste your tunnel token here to automatically run Cloudflare inside Docker:
CLOUDFLARE_TUNNEL_TOKEN=

